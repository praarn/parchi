# Copy to .env and fill in. Never commit the real .env.

# --- Database ---------------------------------------------------------------
# Local dev: point at the docker-compose postgres.
DATABASE_URL=postgresql://bureaucracy:bureaucracy@localhost:5432/bureaucracy

# --- Auth ----------------------------------------------------------------
# Long random string used to sign access-token JWTs.
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-64-char-random-hex-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# --- LLM (Groq) -----------------------------------------------------------
# Free key, no card: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Uploads -----------------------------------------------------------
# Relative path is fine locally; docker-compose mounts a shared volume here.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# --- CORS -------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# --- Worker ---------------------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_STUCK_THRESHOLD_MINUTES=15
JOB_MAX_ATTEMPTS=3

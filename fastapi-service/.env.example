DATABASE_URL=postgresql://bureaucracy:bureaucracy@localhost:5432/bureaucracy

# Get this from https://console.anthropic.com/settings/keys
GROQ_API_KEY=REMOVED-ROTATE-THIS-KEY

# Shared secret — must match INTERNAL_SERVICE_TOKEN in node-api/.env
INTERNAL_SERVICE_TOKEN=REMOVED-INTERNAL-TOKEN

# Embedding model. This project uses a lightweight local embedding fallback by default
# (see app/pipeline/embed.py) so you can run everything with just an Anthropic key.
# Swap in OpenAI/Voyage embeddings later if you want higher-quality retrieval.
EMBEDDING_PROVIDER=local